							"pm.test(\"Response body is empty\", function () {\r",
							"    pm.expect(pm.response.text()).to.equal(\"\");\r",
							"});\r",
							"\r",
							"pm.test(\"Response should be malformed JSON\", function () {\r",
							"    try {\r",
							"        pm.response.json();\r",
							"        pm.expect.fail(\"Response was successfully parsed as JSON, but expected malformed JSON.\");\r",
							"    } catch (e) {\r",
							"        pm.expect(e).to.be.an('error');\r",
							"        pm.expect(e.message).to.include(\"Unexpected token\"); // Common error message for malformed JSON\r",
							"        // You can add more specific error message checks if needed\r",

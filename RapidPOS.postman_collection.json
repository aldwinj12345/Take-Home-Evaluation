		{
			"name": "Slow Resposne username containing slow",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Response status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"pm.test(\"Response body is not empty\", function () {\r",
							"    pm.expect(pm.response.text()).not.to.equal(\"\");\r",
							"});\r",
							"\r",
							"pm.test(\"Response should take approximately 2 seconds\", async function () {\r",
							"    const startTime = Date.now();\r",
							"    await pm.sendRequest({\r",
							"        url: pm.request.url.toString(),\r",
							"        method: pm.request.method,\r",
							"        header: pm.request.headers.all(),\r",
							"        body: pm.request.body.toString() // Ensure body is sent if present\r",
							"    });\r",
							"    const endTime = Date.now();\r",
							"    const responseTimeMs = endTime - startTime;\r",
							"    const expectedDelayMs = 2000;\r",
							"    const toleranceMs = 500; // Allow for some variation\r",
							"\r",
							"    pm.expect(responseTimeMs).to.be.at.least(expectedDelayMs - toleranceMs);\r",
							"    pm.expect(responseTimeMs).to.be.at.most(expectedDelayMs + toleranceMs * 2); // Allow a bit more on the upper end for network variations\r",
							"});"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
